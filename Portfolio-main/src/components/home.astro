---
import Fireflies from "../React/Fireflies.tsx";
import NeuralNetwork from "../React/NeuralNetwork.tsx";
import SkillsList from "../React/SkillsList.tsx";
---

<section class="text-[var(--white)] relative overflow-hidden w-full min-h-screen flex items-center" id="home">
  <Fireflies client:load />
  
  <div class="relative z-10 max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-32 items-center">
    
    {/* Columna Izquierda: Texto */}
    <div class="flex flex-col items-start text-left space-y-6 pt-32 lg:pt-0">
      <p class="text-lg md:text-xl text-[var(--white-icon)] shiny-white">
        Hola, Soy Manuel Carballo
      </p>
      
      <h1 class="text-[var(--white)] text-5xl md:text-7xl font-bold leading-tight">
        Full Stack Developer
      </h1>

      <p class="text-lg md:text-2xl text-[var(--white-icon)] max-w-xl">
        Desarrollador apasionado por la Inteligencia Artificial. Especializándome en
        <span class="text-[var(--sec)] shiny-sec">Python y React</span>,
        buscando crear soluciones innovadoras y seguir aprendiendo.
      </p>

      <div class="flex justify-start gap-4 pt-4">
        <a
          target="_blank"
          href="https://www.linkedin.com/in/manuel-carballo-costas"
          aria-label="LinkedIn"
          class="text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)] hover:scale-110"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="size-7"
          >
            <path
              d="M18.3362 18.339H15.6707V14.1622C15.6707 13.1662 15.6505 11.8845 14.2817 11.8845C12.892 11.8845 12.6797 12.9683 12.6797 14.0887V18.339H10.0142V9.75H12.5747V10.9207H12.6092C12.967 10.2457 13.837 9.53325 15.1367 9.53325C17.8375 9.53325 18.337 11.3108 18.337 13.6245V18.339H18.3362ZM7.00373 8.57475C6.14573 8.57475 5.45648 7.88025 5.45648 7.026C5.45648 6.1725 6.14648 5.47875 7.00373 5.47875C7.85873 5.47875 8.55173 6.1725 8.55173 7.026C8.55173 7.88025 7.85798 8.57475 7.00373 8.57475ZM8.34023 18.339H5.66723V9.75H8.34023V18.339ZM19.6697 3H4.32923C3.59498 3 3.00098 3.5805 3.00098 4.29675V19.7033C3.00098 20.4202 3.59498 21 4.32923 21H19.6675C20.401 21 21.001 20.4202 21.001 19.7033V4.29675C21.001 3.5805 20.401 3 19.6675 3H19.6697Z"></path>
          </svg>
        </a>
        <a
          target="_blank"
          href="mailto:mc.costas12@gmail.com?subject=Contacto%20desde%20tu%20Portfolio"
          aria-label="Email"
          class="text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)] hover:scale-110"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="2.1em"
            height="2.1em"
            viewBox="0 0 24 24"
          >
            <path
              fill="currentColor"
              d="m18.73 5.41l-1.28 1L12 10.46L6.55 6.37l-1.28-1A2 2 0 0 0 2 7.05v11.59A1.36 1.36 0 0 0 3.36 20h3.19v-7.72L12 16.37l5.45-4.09V20h3.19A1.36 1.36 0 0 0 22 18.64V7.05a2 2 0 0 0-3.27-1.64"
            ></path>
          </svg>
        </a>
      </div>
    </div>

    {/* Columna Derecha: Qué hago? (Skills + Red Neuronal de fondo) */}
    <div class="w-full h-[400px] lg:h-full lg:min-h-[500px] relative flex items-center justify-center mt-10 lg:mt-0">
      {/* Red Neuronal de Fondo */}
      <div class="absolute inset-0 z-0 opacity-60 scale-90">
        <NeuralNetwork client:load />
      </div>
      
      {/* Lista de Skills (Desplegables) */}
      <div class="relative z-10 w-full max-w-md flex flex-col items-center justify-center">
        <SkillsList client:load />
      </div>
    </div>
    
  </div>
</section>
<style is:global>
  .shiny-sec {
    background: linear-gradient(135deg, #a476ff 25%, #eee5ff 50%, #a476ff 75%);
    background-size: 400% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shine 3s linear infinite;
  }

  @keyframes shine {
    0% {
      background-position: 100% 50%;
    }
    30%,
    70% {
      background-position: 0% 50%;
    }
  }
</style>
